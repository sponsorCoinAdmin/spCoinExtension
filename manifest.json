{
  "manifest_version": 3,
  "name": "spCoin Merit Wallet",
  "version": "0.0.1",
  "description": "Merit Wallet browser extension for the spCoin app. Phase 1: opens as a docked side panel (real Merit Wallet UI coming later) — no signing, no injection yet.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": ["tabs", "sidePanel"]
}
