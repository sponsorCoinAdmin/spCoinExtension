{
  "name": "@sponsorcoin/spcoin-exchange-engine",
  "version": "0.0.1",
  "description": "Portable ExchangeContext runtime (provider, hooks, cross-process sync client) shared between spcoin-nextjs-front-end and the Merit Wallet browser extension (spCoinExtension) — the engine that will eventually hold/sync a real ExchangeContext, as opposed to @sponsorcoin/spcoin-common's plain types/panel-tree data or @sponsorcoin/spcoin-panels' portable UI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sponsorcoin/spcoin-common": "^0.0.2",
    "@sponsorcoin/spcoin-onchain": "^0.0.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "wagmi": "^2.12.4",
    "viem": "^2.9.25",
    "@tanstack/react-query": "^5.29.2"
  },
  "peerDependenciesMeta": {
    "wagmi": { "optional": true },
    "viem": { "optional": true },
    "@tanstack/react-query": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sponsorCoinAdmin/spcoin-exchange-engine.git"
  },
  "author": "Robert Lanson",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sponsorCoinAdmin/spcoin-exchange-engine/issues"
  },
  "homepage": "https://github.com/sponsorCoinAdmin/spcoin-exchange-engine#readme"
}