{
  "name": "@meritWallets/meritExtension",
  "version": "0.0.1",
  "description": "The EXT shell: opens the wallet (meritWeb) through meritIFrame as the EXT type and passes this host's own functions in as injectables. It does not use the MeritWallet component.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@meritWallets/meritIFrame": "file:../meritIFrame"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "license": "ISC"
}
