{
  "compilerOptions": {
    // 2026-09-25, on request ("migrate useGetBalance/parseValidFormattedAmount")
    // — switched from module:"node16"/moduleResolution:"node16" (strict
    // Node-runtime ESM/CJS boundary enforcement) to "esnext"/"bundler".
    // This package is never consumed by plain Node `require()` — only by
    // Next.js (web app) and Vite (extension), both of which already
    // resolve ESM-only node_modules deps natively; "bundler" resolution is
    // TS's own purpose-built mode for exactly that case. Fixes real,
    // confirmed TS1479 errors trying to import wagmi (ESM-only, no CJS
    // build) and even viem (has a real CJS build, but node16 resolution
    // still flagged it). Also bumped target/lib to ES2020 so BigInt
    // literals (0n) don't need the BigInt(0) workaround future hooks/
    // trade/*.ts files used to route around this same restriction.
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
   "include": ["src"],
   "exclude": ["dist"]
}
