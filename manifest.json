{
  "manifest_version": 3,
  "name": "spCoin Merit Wallet",
  "version": "0.0.1",
  "description": "Merit Wallet browser extension for the spCoin app. Phase 1: opens as a docked side panel (real Merit Wallet UI coming later) — no signing, no injection yet.",
  "icons": {
    "16": "icons/icon16-square.png",
    "32": "icons/icon32-square.png",
    "48": "icons/icon48-square.png",
    "128": "icons/icon128-square.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16-square.png",
      "32": "icons/icon32-square.png",
      "48": "icons/icon48-square.png",
      "128": "icons/icon128-square.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/meritWallet.png", "assets/www.png", "assets/info.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": ["tabs", "sidePanel", "storage", "unlimitedStorage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://sponsorcoin.org/*"
  ]
}
