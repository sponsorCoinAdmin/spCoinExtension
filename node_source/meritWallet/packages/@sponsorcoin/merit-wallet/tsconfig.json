{
  "compilerOptions": {
    // 2026-09-25 — switched module/moduleResolution to "esnext"/"bundler"
    // (from "node16"/"node16"), same reasoning and same pass as
    // @sponsorcoin/spcoin-exchange-engine's own tsconfig.json (see its
    // header comment): this package is never consumed by plain Node
    // require(), only Next.js/Vite. Necessary here specifically, not just
    // consistent — this package already imports heavily from
    // spcoin-exchange-engine (usePanelVisible/usePanelTree/etc. in
    // PanelGate.tsx, MeritWallet.tsx, and others), which switched to
    // `"type": "module"` this same pass; a CJS-configured consumer can no
    // longer statically import an ESM-only dependency, confirmed via a
    // real tsc build (TS1479 across every file importing from that
    // package) the moment that package's own config changed.
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["dist"]
}
