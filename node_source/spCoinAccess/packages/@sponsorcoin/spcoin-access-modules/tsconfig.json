{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@sponsorcoin/spcoin-access-modules": ["./src"]
    },
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": false,
    "noEmitOnError": false
  },
  "include": ["src/**/*.ts"]
}
